---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const projects = await getCollection('projects');
// Sort by date descending
projects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="Selected Projects | ALEX.DEV">
  <main class="flex-grow w-full max-w-container-max mx-auto px-6 md:px-8 py-[120px]">
    <!-- Header Section -->
    <header class="mb-16 max-w-2xl">
      <h1 class="text-display-mobile md:text-display text-on-surface mb-4">
        Selected Projects
      </h1>
      <p class="text-body-lg text-on-surface-variant font-medium">
        A collection of recent work focusing on modern interfaces, thoughtful user experiences, and scalable design systems.
      </p>
    </header>
    
    <!-- Projects Grid -->
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((p) => (
        <a href={`/projects/${p.id}`} class="group bg-surface-container-lowest rounded-xl shadow-ambient hover:shadow-ambient-hover hover:-translate-y-1 transition-all duration-300 ease-in-out overflow-hidden flex flex-col h-full cursor-pointer">
          <div class="relative w-full h-64 overflow-hidden rounded-t-xl bg-surface-variant">
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" src={p.data.coverImage} alt={p.data.title} />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <h3 class="text-headline-md text-on-surface mb-2">{p.data.title}</h3>
            <p class="text-body-md text-on-surface-variant line-clamp-3 mb-4 flex-grow">
              {p.data.description}
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              {p.data.tags.map((t) => (
                <span class="bg-primary-fixed/50 text-on-primary-fixed font-semibold px-3 py-1 rounded-full text-[12px]">{t}</span>
              ))}
            </div>
            <div class="text-label-md text-primary inline-flex items-center group-hover:text-primary-container transition-colors duration-300 font-semibold mt-auto">
              Read More 
              <span class="material-symbols-outlined ml-1 transform group-hover:translate-x-1 transition-transform duration-300" style="font-size: 18px;">arrow_forward</span>
            </div>
          </div>
        </a>
      ))}
    </section>
  </main>
</Layout>
