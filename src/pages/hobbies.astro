---

<Layout title="Hobbies | ALEX.DEV">
  <main class="flex-grow pt-[120px] pb-16 px-6 md:px-8 max-w-[1440px] mx-auto w-full flex flex-col gap-12">
    <!-- Page Header -->
    <header class="text-center max-w-2xl mx-auto">
      <h1 class="text-display-mobile md:text-display text-on-surface mb-4">Life Beyond Code.</h1>
      <p class="text-body-lg text-on-surface-variant font-medium">A collection of creative pursuits, physical activities, and quiet moments that fuel my inspiration and keep me grounded.</p>
    </header>
    <!-- Masonry Gallery -->
    <div class="masonry-grid w-full">
      {hobbies.map((h) => (
        <div class="masonry-item relative group overflow-hidden rounded-[24px] bg-surface-container-lowest p-2 shadow-ambient hover:shadow-ambient-hover transition-all duration-500 hover:-translate-y-1 cursor-pointer">
          <div class={`relative overflow-hidden rounded-[16px] ${h.aspect}`}>
            <img class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110" src={h.img} alt={h.title} />
            <div class="absolute inset-0 bg-inverse-surface/85 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
              <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500 ease-out">
                <h3 class="text-headline-md text-surface-container-lowest mb-1">{h.title}</h3>
                <p class="text-body-md text-surface-container-low line-clamp-2 mb-4">{h.desc}</p>
              </div>
              <span class="material-symbols-outlined text-surface-container-lowest absolute top-6 right-6 opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition-all duration-500 delay-100">arrow_outward</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </main>
</Layout>
