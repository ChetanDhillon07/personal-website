---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About | ALEX.DEV">
  <main class="flex-grow w-full max-w-container-max mx-auto px-6 lg:px-0 py-16 flex flex-col gap-16 pt-[120px]">
    <!-- Hero Section -->
    <section class="flex flex-col-reverse lg:flex-row items-center gap-6 lg:gap-16 fade-in-up">
      <div class="flex-grow flex-1 flex flex-col gap-8 text-center lg:text-left">
        <div class="flex flex-col gap-2">
          <p class="text-primary font-semibold uppercase tracking-widest fade-in-up delay-100">Welcome to my world</p>
          <h1 class="text-display-mobile lg:text-display text-on-surface fade-in-up delay-200">
            Hi, I'm <span class="text-primary">John Doe</span>
          </h1>
          <h2 class="text-headline-md text-on-surface-variant font-normal max-w-2xl fade-in-up delay-300">
            A Grade 9 student passionate about learning, exploring new ideas, and building a bright future.
          </h2>
        </div>
        <div class="flex flex-wrap gap-4 justify-center lg:justify-start fade-in-up delay-300">
          <a href="/projects" class="flex items-center justify-center rounded-full h-14 px-8 bg-primary text-on-primary hover:bg-primary-container hover:text-on-primary-container transition-all shadow-md hover:shadow-lg text-body-lg font-semibold animate-pulse">
            Explore My Journey
          </a>
        </div>
      </div>
      <div class="flex-1 w-full max-w-md lg:max-w-none relative fade-in-up">
        <div class="aspect-[4/5] rounded-2xl overflow-hidden shadow-xl border-4 border-surface">
          <img alt="Portrait of John Doe" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCoejiZ8w0P8P1MlB_mJB-lNcFX8MqQrkjHVflqhNHVTwbjNI7l8ueHmwU2jtshZy4oXJ6VyR9QzzgF6P7cN8FxPE0z3CEuuwlI-m9-zxmkCKvffCDcu_kLQ6ICcB8-Hrg4ujf0GTkaMYViJoRU4CIaToAkzvtQzwq4wUMOSfXnvoXbqS197CwXUE3bvqnnkodEItCaxY2MKJtMls7CYfXAdOjDMVqXuPDB26KOpAOvX-xo9sdPrRGseqdOEB-VA8-FMNA-Z002n-c" />
        </div>
        <!-- Decorative Elements -->
        <div class="absolute -z-10 top-1/2 -right-8 w-64 h-64 bg-secondary-container rounded-full blur-3xl opacity-50"></div>
        <div class="absolute -z-10 -bottom-8 -left-8 w-48 h-48 bg-primary-container rounded-full blur-3xl opacity-40"></div>
      </div>
    </section>

    <!-- About Me Section -->
    <section class="flex flex-col gap-8 fade-in-up">
      <h2 class="text-headline-lg text-on-surface text-center lg:text-left">About Me</h2>
      <div class="flex flex-col lg:flex-row gap-6 lg:gap-16 items-center bg-surface-container-low rounded-2xl p-8 lg:p-12 shadow-sm">
        <div class="w-full lg:w-1/3 aspect-square rounded-xl overflow-hidden shadow-md">
          <img alt="John studying" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCEO8PIZf-zwh_-XX6m8ZpsuYwlunvaG7uSL6PznJnMTGaC5zVY9glLs6CwsaJtixdC9yz21xcU4gtVDicjpmHuiwDQlx-oFlXYoNPV5yCbeKdDQhEfF_d-h8f96Akn8RT4X4vTIKJxw4J67TzzPFxK6LfW4Zw-tgsvyMCle8YGysP6xFV80SZbGbgBTKNaNLN_dTUP7n3Gwgs3XzhWS6WREcgO-Qhm3VK4942yF1dVZBmv0USMzUpcqI4FQiupuccE9v7-RqpWiSA" />
        </div>
        <div class="flex-grow flex-1 flex flex-col gap-4 text-center lg:text-left">
          <h3 class="text-headline-md text-on-surface">Who am I?</h3>
          <p class="text-body-lg text-on-surface-variant">
            I am a dedicated Grade 9 student who loves exploring new subjects and learning new skills. My goal is to discover my true passions and make a positive impact in my community through various projects and extracurricular activities. I believe that every day is an opportunity to learn something new and grow as an individual.
          </p>
          <p class="text-body-lg text-on-surface-variant">
            Outside of school, I enjoy reading science fiction, playing chess, and participating in local coding clubs. I'm always looking for the next challenge!
          </p>
        </div>
      </div>
    </section>

    <!-- Quick Facts Section -->
    <section class="flex flex-col gap-8 fade-in-up">
      <h2 class="text-headline-lg text-on-surface text-center lg:text-left">Quick Facts</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Card 1 -->
        <div class="bg-surface-container-lowest border border-outline-variant/50 rounded-xl p-6 flex flex-col items-center lg:items-start gap-4 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-full bg-primary-container flex items-center justify-center text-on-primary-container">
            <span class="material-symbols-outlined text-3xl">school</span>
          </div>
          <div class="text-center lg:text-left">
            <h4 class="text-body-md font-semibold text-on-surface-variant uppercase tracking-wider">Grade</h4>
            <p class="text-headline-md text-on-surface">9th Grade</p>
          </div>
        </div>
        <!-- Card 2 -->
        <div class="bg-surface-container-lowest border border-outline-variant/50 rounded-xl p-6 flex flex-col items-center lg:items-start gap-4 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-full bg-secondary-container flex items-center justify-center text-on-secondary-container">
            <span class="material-symbols-outlined text-3xl">location_city</span>
          </div>
          <div class="text-center lg:text-left">
            <h4 class="text-body-md font-semibold text-on-surface-variant uppercase tracking-wider">School</h4>
            <p class="text-headline-md text-on-surface">Lincoln High</p>
          </div>
        </div>
        <!-- Card 3 -->
        <div class="bg-surface-container-lowest border border-outline-variant/50 rounded-xl p-6 flex flex-col items-center lg:items-start gap-4 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-full bg-tertiary-container flex items-center justify-center text-on-tertiary-container">
            <span class="material-symbols-outlined text-3xl">science</span>
          </div>
          <div class="text-center lg:text-left">
            <h4 class="text-body-md font-semibold text-on-surface-variant uppercase tracking-wider">Favorite</h4>
            <p class="text-headline-md text-on-surface">Computer Sci</p>
          </div>
        </div>
        <!-- Card 4 -->
        <div class="bg-surface-container-lowest border border-outline-variant/50 rounded-xl p-6 flex flex-col items-center lg:items-start gap-4 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-full bg-surface-variant flex items-center justify-center text-on-surface">
            <span class="material-symbols-outlined text-3xl">rocket_launch</span>
          </div>
          <div class="text-center lg:text-left">
            <h4 class="text-body-md font-semibold text-on-surface-variant uppercase tracking-wider">Dream</h4>
            <p class="text-headline-md text-on-surface">Software Eng</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const runAnimation = () => {
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('.fade-in-up').forEach((el) => {
      observer.observe(el);
    });
    
    setTimeout(() => {
      document.querySelectorAll('.fade-in-up').forEach((el) => {
        const rect = el.getBoundingClientRect();
        if(rect.top < window.innerHeight) {
          el.classList.add('visible');
        }
      });
    }, 100);
  };

  document.addEventListener('DOMContentLoaded', runAnimation);
</script>
